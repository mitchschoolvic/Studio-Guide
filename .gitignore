# Ignore build outputs and binaries
release_builds/
out/
dist/

# Ignore logs and context files
log.txt
generate_context.py
generate_llm_context.py
llm_context_lite.md

# Ignore node_modules and dependencies
node_modules/

# Ignore OS and editor files
.DS_Store
*.swp
*.swo

# Ignore other common binaries
*.exe
*.dll
*.so
*.dylib
*.bin
*.app
*.dmg
*.zip
*.tar.gz
*.tgz
*.tar
*.7z
*.rar
*.iso
*.jar
*.class
*.pyc
*.pyo
*.pyd

# Ignore Vite/React/TypeScript build artifacts
frontend/dist/
frontend/node_modules/
frontend_vanilla/node_modules/

# Ignore environment and config files
.env
.env.*

# Ignore coverage and test output
coverage/
*.lcov

# Ignore VSCode settings
.vscode/
.idea/

# Ignore video/audio assets (large binaries)
*.mp4
*.mov
*.avi
*.mkv

# Ignore generated packaging scripts (environment-specific)
packaging_scripts/recreate_repo.sh

# Ignore generated status files from the root
GITHUB_CLEANUP_STATUS.md
SECURITY_NOTICE.md
PUSH_STATUS.md
